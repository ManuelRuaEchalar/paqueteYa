<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f97316">
  <title><%= typeof title !== 'undefined' ? title + ' · PaqueteYa' : 'PaqueteYa' %></title>
  <script>
    // Nombre de la marca aún sin decidir: el botón junto al logo alterna entre ambos (se recuerda por navegador).
    (function () {
      var B = { ya: ['Paquete<b>Ya</b>', 'PaqueteYa'], sucre: ['Paquetería <b>Sucre</b>', 'Paquetería Sucre'] };
      function get() { try { return localStorage.getItem('brand') === 'sucre' ? 'sucre' : 'ya'; } catch (e) { return 'ya'; } }
      window.applyBrand = function () {
        var k = get(), b = B[k];
        document.documentElement.setAttribute('data-brand', k);
        document.querySelectorAll('[data-brand]:not(html)').forEach(function (el) { el.innerHTML = b[0]; });
        document.querySelectorAll('[data-brand-txt]').forEach(function (el) { el.textContent = b[1]; });
        document.title = document.title.replace(/PaqueteYa|Paquetería Sucre/g, b[1]);
      };
      window.swapBrand = function () {
        try { localStorage.setItem('brand', get() === 'sucre' ? 'ya' : 'sucre'); } catch (e) {}
        applyBrand();
      };
      document.documentElement.setAttribute('data-brand', get());
      document.addEventListener('DOMContentLoaded', applyBrand);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="icon" href="/img/logo.jpeg" type="image/jpeg">
</head>
